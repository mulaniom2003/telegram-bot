# ─────────────────────────────────────────────────────────────
# Telegram Broadcaster Bot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to Git!
# ─────────────────────────────────────────────────────────────

# Your bot token from @BotFather on Telegram
# Example: 7123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs allowed to use admin commands
# Leave empty to allow everyone (open mode — not recommended for production)
# Get your ID by messaging @userinfobot or using /myid after starting the bot
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=
